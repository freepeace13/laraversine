{
    "name": "freepeace13/laraversine",
    "type": "library",
    "description": "Find the nearest destinations in Laravel using the haversine formula.",
    "keywords": ["laravel", "haversine", "geolocation", "nearby", "eloquent"],
    "license": "MIT",
    "authors": [
        {
            "name": "Kin Basco",
            "email": "freepeace13@gmail.com",
            "homepage": "https://github.com/freepeace13"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0",
        "orchestra/testbench": "^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "Laraversine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laraversine\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laraversine\\LaraversineServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
