{
    "name": "freepeace13/laraversine",
    "type": "library",
    "description": "Find the nearest locations in Laravel with Eloquent using the haversine formula. Fast bounded radius and nearest-record search on MySQL, MariaDB, PostgreSQL and SQLite.",
    "keywords": [
        "laravel",
        "eloquent",
        "haversine",
        "geolocation",
        "geospatial",
        "nearby",
        "nearest",
        "distance",
        "radius",
        "latitude",
        "longitude",
        "gps",
        "mysql",
        "mariadb",
        "postgresql",
        "sqlite"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Kin Basco",
            "email": "freepeace13@gmail.com",
            "homepage": "https://github.com/freepeace13"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0|^12.0",
        "orchestra/testbench": "^10.0|^11.0",
        "laravel/pint": "^1.25"
    },
    "autoload": {
        "psr-4": {
            "Laraversine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laraversine\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint",
        "lint:check": "pint --test",
        "bench": "phpunit -c benchmarks/phpunit.xml"
    },
    "extra": {
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Laraversine\\LaraversineServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "issues": "https://github.com/freepeace13/laraversine/issues",
        "source": "https://github.com/freepeace13/laraversine"
    },
    "homepage": "https://github.com/freepeace13/laraversine",
    "config": {
        "sort-packages": true
    }
}
