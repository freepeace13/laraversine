#!/usr/bin/env bash
# Show what changed in the public surface since the last release tag on a branch.
# Usage: bin/bc-diff [branch]   (default: current branch)
set -euo pipefail

branch="${1:-$(git rev-parse --abbrev-ref HEAD)}"
git fetch -q origin --tags

# The baseline is the last release on this line, read from the manifest release-please
# maintains, not the nearest tag (merge-ups bring other majors' tags into reach).
version=$(git show "origin/$branch:.release-please-manifest.json" | jq -r '.["."]')
tag="v$version"
if ! git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
  echo "Tag $tag (from the manifest on origin/$branch) does not exist" >&2
  exit 1
fi

echo "Comparing origin/$branch against $tag"
echo
git diff --stat "$tag..origin/$branch" -- src config database composer.json
echo
git diff "$tag..origin/$branch" -- src config database composer.json
