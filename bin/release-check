#!/usr/bin/env bash
# Summarise every open release-please PR: version, CI status, and the commits it releases.
# Usage: bin/release-check
set -euo pipefail
git fetch -q origin --tags

prs=$(gh pr list --state open --search "release in:title" --json number,title,baseRefName \
  --jq '.[] | select(.title | startswith("chore(")) | "\(.number)\t\(.baseRefName)\t\(.title)"')

if [[ -z "$prs" ]]; then
  echo "No open release PRs."
  exit 0
fi

while IFS=$'\t' read -r number base title; do
  echo "== #$number ($base) $title"
  gh pr checks "$number" 2>&1 | sed 's/^/   /' || true
  echo "   commits since the last release ($base):"
  version=$(git show "origin/$base:.release-please-manifest.json" | jq -r '.["."]')
  tag="v$version"
  if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
    git log --no-merges --format='     %s' "$tag..origin/$base"
  else
    echo "     (tag $tag from the manifest not found)"
  fi
done <<< "$prs"

echo
echo "2.x and main both propose the same version while identical: merge one, close the other."
